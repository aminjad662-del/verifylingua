# ==============================================================================
# VerifyLingua Autonomous Document Translation SaaS Environment Configuration
# ==============================================================================

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verifylingua?schema=public"

# Authentication (Clerk / NextAuth)
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
AUTH_SECRET="super-secret-auth-key-min-32-chars-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 Object Storage (Private Vault)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="verifylingua-documents"
AWS_REGION="auto"

# Inngest Background Workflow Engine
INNGEST_EVENT_KEY="your_inngest_event_key"
INNGEST_SIGNING_KEY="your_inngest_signing_key"

# Primary Translation Provider: Azure Translator
AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"
AZURE_TRANSLATOR_KEY="your_azure_translator_key"
AZURE_REGION="global"

# Document Intelligence & OCR: Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="your_azure_document_intelligence_key"

# Fallback Translation: Google Cloud Translation
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/credentials.json"
GOOGLE_TRANSLATE_API_KEY="AIzaSy..."

# Premium Legal Translation: DeepL API
DEEPL_API_KEY="7dbfa8c2-d1fc-4453-940a-4cfda3861f97:fx"

# Semantic QA & Layout Evaluation: Google Gemini
GEMINI_API_KEY="AIzaSy..."

# Billing & Quotas: Stripe
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51..."

# Observability & Monitoring: Sentry
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Product Analytics: PostHog
POSTHOG_KEY="phc_..."
POSTHOG_HOST="https://us.i.posthog.com"

# Transactional Notifications: Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="VerifyLingua <support@verifylingua.com>"

# App Host
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRODUCT_NAME="VerifyLingua"
NEXT_PUBLIC_SUPPORT_EMAIL="support@verifylingua.com"
