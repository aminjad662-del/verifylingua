{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verifylingua",
  "main": "dist/_worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "NODE_VERSION": "22.16.0"
  }
}
